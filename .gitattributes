# Force LF line endings in the repo for all text files
* text=auto

# Shell scripts MUST be LF — CRLF breaks bash on Linux
*.sh text eol=lf

# Python files — LF
*.py text eol=lf

# Config and data files — LF
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf

# Binary files — no line ending conversion
*.ogg  binary
*.wav  binary
*.mp3  binary
*.h5   binary
*.hdf5 binary
*.ckpt binary
*.pt   binary
*.pth  binary
*.parquet binary
*.zip  binary
*.png  binary
*.jpg  binary
