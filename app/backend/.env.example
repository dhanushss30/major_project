# Copy this file to .env and fill in your values

# === Required for AI chatbot / RAG ===
# Get a FREE key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === Optional overrides ===
# DEVICE=cuda            # use "cuda" if you have a GPU, "cpu" otherwise
# TTA_HOP_SEC=2.5
# DEFAULT_TOP_K=5
# DEFAULT_NO_BIRD_THR=0.10
# CONSISTENCY_BOOST=0.05

# === Paths (only override if not at default location) ===
# TRAIN_CSV=C:/Users/User/Downloads/birdclef-2025/train.csv

# === Server ===
HOST=0.0.0.0
PORT=8081
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
